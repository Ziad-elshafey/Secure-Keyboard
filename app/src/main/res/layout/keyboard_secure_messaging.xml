<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="4dp">

    <!-- ═══════════════ Toolbar ═══════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_keyboard_arrow_left"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Secure Messaging"
            android:textSize="14sp"
            android:textColor="@color/tv_text"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />

        <!-- Nav tabs -->
        <TextView
            android:id="@+id/btn_compose"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="✏️"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_inbox"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="📥"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="⏏"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Thin divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- ═══════════════ State Flipper ═══════════════ -->
    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ─── State 0: NOT LOGGED IN ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 Not logged in"
                android:textSize="14sp"
                android:textColor="@color/tv_text"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open the app → 🔑 Secure Messaging to login or register first."
                android:textSize="12sp"
                android:textColor="#757575"
                android:gravity="center"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- ─── State 1: COMPOSE ─── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <!-- Search row: EditText + Search button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:hint="Username"
                        android:textSize="13sp"
                        android:textColor="@color/tv_text"
                        android:background="@drawable/bg_edittext_rounded"
                        android:paddingHorizontal="8dp"
                        android:singleLine="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:imeOptions="actionDone"
                        android:inputType="text" />

                    <Button
                        android:id="@+id/btn_search"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="🔍"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:layout_marginStart="4dp"
                        android:minWidth="48dp" />
                </LinearLayout>

                <!-- Search results / conversation create area -->
                <TextView
                    android:id="@+id/tv_search_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/tv_text"
                    android:paddingTop="4dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_start_conversation"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:text="Start Conversation"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:layout_marginTop="2dp" />

                <!-- Message compose area (visible after conversation is selected) -->
                <LinearLayout
                    android:id="@+id/compose_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="4dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:id="@+id/tv_compose_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Messaging: ..."
                        android:textSize="12sp"
                        android:textColor="@color/tv_text"
                        android:textStyle="bold"
                        android:paddingTop="4dp" />

                    <!-- Send button (reads from the host app's text field) -->
                    <Button
                        android:id="@+id/btn_send"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="🔒 Encrypt &amp; Send"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tv_send_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/tv_text"
                        android:paddingTop="2dp" />

                    <!-- Obfuscated output preview -->
                    <ScrollView
                        android:id="@+id/scroll_obfuscated"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:visibility="gone"
                        android:layout_marginTop="2dp"
                        android:background="#F5F5F5"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tv_obfuscated_preview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/tv_text"
                            android:fontFamily="monospace" />
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ─── State 2: DECRYPT ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📥 Decrypt Message"
                android:textSize="13sp"
                android:textColor="@color/tv_text"
                android:textStyle="bold"
                android:paddingBottom="2dp" />

            <!-- Encrypted message input -->
            <EditText
                android:id="@+id/et_encrypted_input"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:hint="Paste obfuscated text here..."
                android:textSize="12sp"
                android:textColor="@color/tv_text"
                android:background="@drawable/bg_edittext_rounded"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:gravity="top|start"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="textMultiLine"
                android:scrollbars="vertical" />

            <!-- Sender username input -->
            <EditText
                android:id="@+id/et_sender_username"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:hint="Sender's username"
                android:textSize="13sp"
                android:textColor="@color/tv_text"
                android:background="@drawable/bg_edittext_rounded"
                android:paddingHorizontal="8dp"
                android:singleLine="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="text"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_refresh_inbox"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:text="🔓 Decrypt Message"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_inbox_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/tv_text"
                android:paddingTop="2dp" />
        </LinearLayout>

        <!-- ─── State 3: DECRYPT RESULT ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔓 Decrypted Message"
                android:textSize="13sp"
                android:textColor="@color/tv_text"
                android:textStyle="bold"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/tv_decrypt_from"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#757575"
                android:paddingBottom="2dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#F5F5F5"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tv_decrypted_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/tv_text"
                    android:hint="Decrypting..." />
            </ScrollView>

            <Button
                android:id="@+id/btn_back_to_inbox"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:text="← Back to Inbox"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_decrypt_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/tv_text"
                android:paddingTop="2dp" />
        </LinearLayout>

    </ViewFlipper>

</LinearLayout>
