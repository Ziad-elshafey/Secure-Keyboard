<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel_gradient">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_keyboard_arrow_left"
            android:tint="@color/secure_text_primary"
            android:contentDescription="@string/cd_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_secure_lock"
                android:contentDescription="@string/cd_encrypt_icon" />

            <TextView
                android:id="@+id/tv_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/secure_title"
                android:textSize="14sp"
                android:textColor="@color/secure_text_primary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="6dp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_compose"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            style="@style/SecureTabPill"
            android:text="@string/secure_tab_encrypt"
            android:visibility="gone"
            android:layout_marginEnd="4dp"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btn_inbox"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            style="@style/SecureTabPill"
            android:text="@string/secure_tab_decrypt"
            android:visibility="gone"
            android:layout_marginEnd="6dp"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btn_logout"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_secure_logout"
            android:visibility="gone"
            android:contentDescription="@string/cd_logout"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Toolbar shadow -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/bg_toolbar_shadow" />

    <!-- State Flipper -->
    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inAnimation="@anim/fade_in"
        android:outAnimation="@anim/fade_out">

        <!-- State 0: NOT LOGGED IN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_elevated"
                android:padding="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_secure_lock"
                    android:contentDescription="@string/cd_encrypt_icon" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/secure_not_logged_in"
                    android:textSize="14sp"
                    android:textColor="@color/secure_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/secure_not_logged_in_hint"
                    android:textSize="11sp"
                    android:textColor="@color/secure_text_secondary"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:lineSpacingMultiplier="1.2" />

                <Button
                    android:id="@+id/btn_open_login"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_btn"
                    android:drawableStart="@drawable/ic_secure_login"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/secure_btn_text"
                    android:text="@string/secure_login"
                    android:textColor="@color/secure_btn_text"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- State 1: COMPOSE / ENCRYPT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <!-- Search row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:hint="@string/secure_search_hint"
                        style="@style/SecureInput"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:drawableStart="@drawable/ic_secure_search"
                        android:drawablePadding="8dp" />

                    <ImageButton
                        android:id="@+id/btn_clear_search"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_secure_clear"
                        android:visibility="gone"
                        android:contentDescription="@string/cd_clear"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/btn_search"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="7dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:src="@drawable/ic_secure_search"
                        android:contentDescription="@string/cd_search" />
                </LinearLayout>

                <!-- Loading indicator for search -->
                <ProgressBar
                    android:id="@+id/progress_search"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:visibility="gone"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/secure_accent"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    tools:visibility="visible" />

                <!-- Search results -->
                <TextView
                    android:id="@+id/tv_search_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/secure_text_secondary"
                    android:paddingTop="6dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_start_conversation"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="@string/secure_start_conversation"
                    style="@style/SecureBtnSecondary"
                    android:visibility="gone"
                    android:layout_marginTop="6dp" />

                <!-- Message compose area -->
                <LinearLayout
                    android:id="@+id/compose_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card_elevated"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tv_compose_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/secure_accent"
                        android:fontFamily="sans-serif-medium"
                        android:paddingBottom="4dp"
                        android:drawableStart="@drawable/ic_secure_encrypt"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/secure_accent"
                        tools:text="Messaging: alice" />

                    <Button
                        android:id="@+id/btn_send"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:text="@string/secure_encrypt_send"
                        android:drawableStart="@drawable/ic_secure_send"
                        android:drawablePadding="6dp"
                        style="@style/SecureBtnPrimary" />

                    <!-- Loading indicator for send -->
                    <ProgressBar
                        android:id="@+id/progress_send"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:visibility="gone"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/secure_accent"
                        style="@android:style/Widget.ProgressBar.Horizontal" />

                    <TextView
                        android:id="@+id/tv_send_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/secure_text_secondary"
                        android:paddingTop="6dp" />

                    <!-- Obfuscated output preview -->
                    <LinearLayout
                        android:id="@+id/obfuscated_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="6dp"
                        android:background="@color/secure_bg_panel"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/secure_obfuscated_label"
                                style="@style/SecureLabel" />

                            <Button
                                android:id="@+id/btn_copy_obfuscated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/secure_copy"
                                android:drawableStart="@drawable/ic_secure_copy"
                                android:drawablePadding="4dp"
                                style="@style/SecureCopyBtn"
                                android:contentDescription="@string/cd_copy" />
                        </LinearLayout>

                        <ScrollView
                            android:id="@+id/scroll_obfuscated"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/tv_obfuscated_preview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textColor="@color/secure_text_secondary"
                                android:fontFamily="monospace" />
                        </ScrollView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- State 2: DECRYPT INPUT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- Clipboard status -->
            <TextView
                android:id="@+id/tv_clipboard_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/secure_text_secondary"
                android:drawableStart="@drawable/ic_secure_paste"
                android:drawablePadding="4dp"
                android:drawableTint="@color/secure_accent"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/et_sender_username"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:hint="@string/secure_sender_hint"
                style="@style/SecureInput"
                android:singleLine="true"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_refresh_inbox"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="@string/secure_decrypt_btn"
                android:drawableStart="@drawable/ic_secure_decrypt"
                android:drawablePadding="6dp"
                android:drawableTint="@color/secure_btn_text"
                style="@style/SecureBtnPrimary"
                android:layout_marginTop="4dp" />

            <!-- Loading indicator for decrypt -->
            <ProgressBar
                android:id="@+id/progress_decrypt"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:visibility="gone"
                android:indeterminate="true"
                android:indeterminateTint="@color/secure_accent"
                style="@android:style/Widget.ProgressBar.Horizontal" />

            <TextView
                android:id="@+id/tv_inbox_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/secure_text_secondary"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- State 3: DECRYPT RESULT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_elevated"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_secure_decrypt"
                        android:contentDescription="@string/cd_decrypt_icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/secure_decrypted_title"
                        style="@style/SecureSectionHeader"
                        android:layout_marginStart="6dp" />

                    <Button
                        android:id="@+id/btn_copy_decrypted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/secure_copy"
                        android:drawableStart="@drawable/ic_secure_copy"
                        android:drawablePadding="4dp"
                        style="@style/SecureCopyBtn"
                        android:contentDescription="@string/cd_copy" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_decrypt_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/secure_text_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:paddingBottom="6dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@color/secure_decrypt_result_bg"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_decrypted_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/secure_text_primary"
                        android:hint="@string/secure_decrypting_hint"
                        android:textColorHint="@color/secure_text_secondary"
                        android:lineSpacingMultiplier="1.3" />
                </ScrollView>
            </LinearLayout>

            <Button
                android:id="@+id/btn_back_to_inbox"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:text="@string/secure_back"
                android:drawableStart="@drawable/ic_keyboard_arrow_left"
                android:drawablePadding="4dp"
                android:drawableTint="@color/secure_text_primary"
                style="@style/SecureBtnSecondary"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_decrypt_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/secure_text_secondary"
                android:paddingTop="4dp" />
        </LinearLayout>

    </ViewFlipper>

</LinearLayout>
