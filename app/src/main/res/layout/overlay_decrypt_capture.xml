<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#DD333333"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvCaptureInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/decrypt_capture_instruction"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:drawablePadding="8dp" />

    <Button
        android:id="@+id/btnCancelCapture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/decrypt_capture_cancel"
        android:textColor="#FFFFFF"
        android:backgroundTint="#88FF5252"
        android:minHeight="36dp"
        android:layout_marginStart="8dp" />

</LinearLayout>
