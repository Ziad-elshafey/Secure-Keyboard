<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_dark"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 Encrypt"
        android:textSize="16sp"
        android:textColor="@color/secure_text_primary"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- Selected text preview -->
    <TextView
        android:id="@+id/tv_label_text"
        style="@style/SecureLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selected text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_input_dark"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_selected_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/secure_text_secondary"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- Recipient username -->
    <TextView
        android:id="@+id/tv_label_username"
        style="@style/SecureLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipient's username"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/et_username"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        style="@style/SecureInput"
        android:hint="Who should receive this?"
        android:singleLine="true"
        android:inputType="text" />

    <!-- Action button -->
    <Button
        android:id="@+id/btn_action"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        style="@style/SecureBtnPrimary"
        android:text="🔒  Encrypt"
        android:layout_marginTop="10dp" />

    <!-- Status -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/secure_text_secondary"
        android:paddingTop="6dp" />

    <!-- Cancel -->
    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        style="@style/SecureBtnSecondary"
        android:text="Cancel"
        android:layout_marginTop="6dp" />

</LinearLayout>
