<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MiniKey" parent="@android:style/Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:backgroundTint">@color/secure_text_primary</item>
        <item name="android:textColor">@color/secure_bg_panel</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">1dp</item>
    </style>

    <!-- Secure Messaging Styles -->

    <style name="SecureInput">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/secure_text_primary</item>
        <item name="android:textColorHint">@color/secure_text_secondary</item>
        <item name="android:background">@drawable/bg_input_selector</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <style name="SecureBtnPrimary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/secure_btn_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="SecureBtnSecondary">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/secure_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <style name="SecureLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/secure_text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="SecureTabPill">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/secure_tab_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/bg_tab_inactive_new</item>
    </style>

    <style name="SecureSectionHeader">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/secure_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:drawablePadding">6dp</item>
    </style>

    <style name="SecureCopyBtn">
        <item name="android:background">@drawable/bg_copy_btn</item>
        <item name="android:textColor">@color/secure_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

</resources>
